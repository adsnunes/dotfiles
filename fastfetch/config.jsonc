// graphite · fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": { "1": "white", "2": "white" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "90", "title": "37" },
    "key": { "width": 8 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "custom", "format": "\u001b[90m────────────────────" },
    { "type": "host", "key": "host", "format": "{family}" },
    { "type": "os", "key": "os", "format": "{name}" },
    { "type": "kernel", "key": "kernel", "format": "{release}" },
    { "type": "wm", "key": "wm", "format": "{pretty-name}" },
    { "type": "terminal", "key": "term", "format": "{pretty-name}" },
    { "type": "memory", "key": "mem", "format": "{used} / {total}" },
    { "type": "battery", "key": "bat", "format": "{capacity}" },
    { "type": "uptime", "key": "up" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
